WEBEX_BOT_TOKEN=your-webex-bot-token
WEBEX_BOT_PERSON_ID=your-webex-bot-person-id
WEBEX_WEBHOOK_NAME=FSS Webhook
WEBEX_WEBHOOK_TARGET_URL=https://your-ngrok-url.ngrok-free.app/webex/webhook
WEBEX_ROOM_ID=

# Debug endpoints are disabled by default. Enable only in trusted environments.
FSS_DEBUG_API_ENABLED=false
FSS_DEBUG_API_TOKEN=
FSS_ADMIN_EMAIL=sh_lee@lotte.net
# Comma-separated immutable Webex personIds allowed to use force reset and
# mahjong battle host eviction. Display names and email addresses are not accepted.
FSS_FORCE_RESET_ADMIN_PERSON_IDS=your-webex-person-id

# Required: unique random value of at least 32 characters. Keep it secret.
# Changing or losing it makes existing encrypted state unreadable.
FSS_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
FSS_MAHJONG_EFFICIENCY_STORE_PATH=data/mahjong_efficiency.json
FSS_MAHJONG_BATTLE_STORE_PATH=data/mahjong_battles.json
